ORIGIN=http://localhost:5200

# Session cookie signing secret. Required in production (>= 16 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# OBP API Configuration
PUBLIC_OBP_BASE_URL="http://localhost:8080"
OBP_API_HOST=localhost:8080
OBP_API_URL=http://localhost:8080

# Entity Prefix Configuration (optional, defaults to empty)
# OBP_ENTITY_PREFIX=

# The bank (aka Space) the OGCR dynamic entities are defined at. Every
# dynamic-entity call goes to /obp/dynamic-entity/banks/<this>/<entity>, and the
# entity Roles are checked and requested at this bank id. Same variable as in
# OGCR-DynamicEntities, so set them to the same value. Defaults to ogcr; set it
# to the empty string for system level entities.
# OBP_ENTITY_SPACE_ID=ogcr

# OIDC Configuration (OBP-OIDC provider)
OBP_OAUTH_CLIENT_ID=your-client-id
OBP_OAUTH_CLIENT_SECRET=your-client-secret
OBP_OAUTH_WELL_KNOWN_URL=http://127.0.0.1:9000/obp-oidc/.well-known/openid-configuration
APP_CALLBACK_URL=http://localhost:5200/login/callback

# Optional: Keycloak Configuration (if using Keycloak provider)
# KEYCLOAK_OAUTH_CLIENT_ID=your-keycloak-client-id
# KEYCLOAK_OAUTH_CLIENT_SECRET=your-keycloak-client-secret

# Optional: Google Configuration (if using Google provider)
# Register a Web application OAuth client in Google Cloud Console with
# APP_CALLBACK_URL as an authorized redirect URI.
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"  # Optional: uncomment if Redis requires authentication

# Optional: block explorer for the OGCR chain (Blockscout or Etherscan style).
# When set, transaction hashes, blocks and addresses on /chain become links.
# A private chain has no explorer unless you run one, so this is left unset by
# default and those values render as plain text.
# PUBLIC_CHAIN_EXPLORER_URL=http://localhost:4000

# Optional: the OGCR tokenizer's health endpoint, so it appears on /status.
# The tokenizer never writes to OBP, so this is the only signal that it is
# running. Unset means it is simply not monitored.
# TOKENIZER_HEALTH_URL=http://localhost:8081/healthz
